{
  "name": "pi-gui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "sidecar": "tsx sidecar/src/main.ts",
    "dev:bridge": "node dev/ws-bridge.mjs",
    "dev": "concurrently -n bridge,vite -c blue,green \"pnpm dev:bridge\" \"vite\"",
    "desktop": "GDK_BACKEND=x11 WEBKIT_DISABLE_COMPOSITING_MODE=1 LIBGL_ALWAYS_SOFTWARE=1 sh -c 'cd src-tauri && cargo build && cd .. && ./src-tauri/target/debug/pi-gui'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  }
}
