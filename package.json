{
  "name": "pi-gui",
  "version": "0.1.0-alpha",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "sidecar": "tsx sidecar/src/main.ts",
    "dev:bridge": "node dev/ws-bridge.mjs",
    "dev": "concurrently -n bridge,vite -c blue,green \"pnpm dev:bridge\" \"vite\"",
    "desktop": "GDK_BACKEND=x11 WEBKIT_DISABLE_COMPOSITING_MODE=1 LIBGL_ALWAYS_SOFTWARE=1 sh -c 'cd src-tauri && cargo build && cd .. && ./src-tauri/target/debug/pi-gui'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx dev/eval/run.ts",
    "eval:taste": "tsx dev/eval/taste.ts",
    "sidecar-rt": "pnpm --dir sidecar-rt install --config.node-linker=hoisted --frozen-lockfile",
    "appimage": "pnpm sidecar-rt && NO_STRIP=1 tauri build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "lucide-react": "^1.47.0",
    "puppeteer-core": "^25.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  }
}
