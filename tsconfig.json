{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["sidecar/src", "shared", "src", "dev"],
  "exclude": ["dev/eval/tasks"]
}
