{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi",
  "version": "0.0.1",
  "identifier": "dev.pigui.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pi",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "deb",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
