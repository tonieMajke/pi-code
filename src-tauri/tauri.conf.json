{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Code",
  "version": "0.0.4",
  "identifier": "dev.pigui.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm exec vite build && pnpm exec esbuild sidecar/src/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=sidecar/dist/main.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Pi",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/main.mjs": "sidecar/dist/main.mjs",
      "../sidecar-rt/node_modules/": "sidecar/node_modules/",
      "../skills/": "skills/"
    },
    "category": "Development",
    "shortDescription": "GUI do pi (pi-coding-agent)"
  }
}
